{
  "name": "qlcv-y-khoa-demo",
  "version": "1.0.0",
  "description": "Hệ Thống Quản Lý Công Việc Y Khoa - Demo Application",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "hospital",
    "task-management",
    "healthcare",
    "demo"
  ],
  "author": "Development Team",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.hospital.qlcv",
    "productName": "QLCV Y Khoa",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "electron-main.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app-icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "app-icon.icns",
      "category": "public.app-category.healthcare-fitness"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "app-icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QLCV Y Khoa"
    }
  }
}
